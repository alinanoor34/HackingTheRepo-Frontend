# API base URL (leave empty in local Vite to use /api proxy → :5000)
VITE_API_URL=

# Set to "false" to hide GitHub OAuth UI
VITE_GITHUB_OAUTH_ENABLED=true

# Set to "true" once the backend exposes GET /auth/google and /auth/google/callback
VITE_GOOGLE_OAUTH_ENABLED=false

# Legal pages linked from the signup form (defaults: /terms and /privacy)
VITE_TERMS_URL=/terms
VITE_PRIVACY_URL=/privacy

# Optional observability
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_OTEL_TRACES_ENDPOINT=
VITE_OTEL_SERVICE_NAME=repomind-frontend
VITE_METRICS_ENABLED=false
VITE_METRICS_URL=
